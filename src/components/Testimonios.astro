---
import { testimonios } from '../data/testimonios';
---

<section class=" py-40 px-4 sm:px-6 lg:px-8 tex   text-[#408657]  ">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-bold  mb-8">Testimonios</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {testimonios.map((item) => (
        <article class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden border border-gray-100 flex flex-col justify-between">
          <div>
            <!-- Imagen con contenedor proporciones fijas -->
            <div class="w-full h-52 bg-gray-100 overflow-hidden">
              <img 
                src={item.imagen} 
                alt={item.titulo} 
                class="w-full h-full object-cover"
              />
            </div>

            <!-- Contenido -->
            <div class="p-5">
              <h2 class="text-xl font-bold leading-snug mb-2 hover:text-[#326342]">
                <a href={`/testimonio/${item.slug}`}>
                  {item.titulo}
                </a>
              </h2>
              <time class="block text-xs text-[#4e9967] mb-3">{item.fecha}</time>
              <p class="text-normal text-[#4e9967] line-clamp-3 leading-relaxed">
                {item.extracto}
              </p>
            </div>
          </div>

          <!-- Botón Leer más -->
          <div class="px-5 pb-5 pt-2">
            <a
              href={`/testimonio/${item.slug}`}
              class="inline-block bg-[#408657] hover:bg-[#326342] text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors duration-200"
            >
              Leer más
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>