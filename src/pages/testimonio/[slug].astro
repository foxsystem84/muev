---
import Layout from "../../layouts/Layout.astro";
import { testimonios, type Testimonio } from "../../data/testimonios";

export async function getStaticPaths() {
  return testimonios.map((testimonio) => ({
    params: { slug: testimonio.slug },
    props: { testimonio },
  }));
}

interface Props {
  testimonio: Testimonio;
}

const { testimonio } = Astro.props;
---

<Layout>
  <main class="max-w-4xl mx-auto px-6 py-40 bg-">
    <!-- Botón volver -->
    <a
      href="/testimonio"
      class="inline-flex items-center text-sm font-medium text-[#408657] hover:underline mb-8"
    >
      &larr; Volver a testimonios
    </a>

    <!-- Encabezado de la noticia/testimonio -->
    <h1
      class="text-3xl md:text-5xl font-bold text-[#408657] mb-4 leading-tight"
    >
      {testimonio.titulo}
    </h1>
    <p class="text-sm text-[#408657] mb-8">{testimonio.fecha}</p>

    <!-- Imagen principal -->
    <div class="w-full h-80 sm:h-96 rounded-2xl overflow-hidden mb-8 shadow-md">
      <img
        src={testimonio.imagen}
        alt={testimonio.titulo}
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Cuerpo del testimonio -->
    <p class="text-[#408657] font-semibold mb-4">{testimonio.citaBiblica}</p>

    <article
      class="prose prose-lg max-w-none text-[#4e9967] space-y-6 leading-relaxed text-lg"
    >
      <p>{testimonio.subtitulo}</p>
      {testimonio.contenidoCompleto.map((parrafo) => <p>{parrafo}</p>)}
    </article>
  </main>
</Layout>
